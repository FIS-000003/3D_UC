<UserControl x:Class="UserControl3D.UserControl1"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:h="http://helix-toolkit.org/wpf/SharpDX"
             mc:Ignorable="d" d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid Grid.Row="0">
            <h:Viewport3DX x:Name="viewport" Loaded="viewport_Loaded" Background="LightSlateGray"
                           ShowCoordinateSystem="True" ShowViewCube="True" FixedRotationPointEnabled="True"
                           EffectsManager="{Binding EffectsManager}" MouseMove="viewport_MouseMove" MouseLeave="viewport_MouseLeave">
                <h:Viewport3DX.InputBindings>
                    <MouseBinding Gesture="MiddleClick" Command="{x:Static h:ViewportCommands.Pan}" />
                </h:Viewport3DX.InputBindings>
                <h:AmbientLight3D Color="White" />
            </h:Viewport3DX>
            <Border x:Name="PointInfo" Visibility="Collapsed" HorizontalAlignment="Left" VerticalAlignment="Top"
                    Padding="8,5" Background="White" BorderBrush="Black" BorderThickness="1" CornerRadius="3" IsHitTestVisible="False">
                <TextBlock x:Name="PointInfoText" FontSize="13" Foreground="Black" />
            </Border>
        </Grid>
        <DockPanel Grid.Row="2" Margin="0,8,0,0">
            <ProgressBar DockPanel.Dock="Right" Width="120" Height="10" IsIndeterminate="True"
                         Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
            <TextBlock Text="{Binding Status}" Margin="0,0,10,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
        </DockPanel>
    </Grid>
</UserControl>
