<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.19041</TargetFramework>
    <RootNamespace>UserControl3D</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="HelixToolkit.Wpf.SharpDX" Version="3.1.2" />
    <PackageReference Include="MVTec.HalconDotNetXL" Version="26050.0.0" />
    <PackageReference Include="MVTec.HalconDotNetXL-Windows" Version="26050.0.0" />
    <PackageReference Include="ReactiveUI.Binding.SourceGenerators" Version="8.8.1">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="ReactiveUI.SourceGenerators" Version="4.2.0" />
    <PackageReference Include="ReactiveUI.WPF" Version="24.1.0" />
  </ItemGroup>
</Project>
